+// split-flap patch: every request is parsed before any handler (and its authentication) runs, and
+// each parameter and header is a separate heap object - a small body of "&&&..." used up the heap.
+// A request over the limits in ESPAsyncWebSrv.h is dropped: no handler runs, the connection is
+// closed. PARSE_REQ_FAIL stops any further parsing of its data.
+#define SPLITFLAP_REJECT_REQUEST() do { _parseState = PARSE_REQ_FAIL; _client->close(); } while(0)
+#define SPLITFLAP_HEAP_LOW() (ESP.getFreeHeap() < ASYNCWEBSERVER_MIN_FREE_HEAP)
+
