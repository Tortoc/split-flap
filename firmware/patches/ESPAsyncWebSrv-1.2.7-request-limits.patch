+// split-flap patch: request parser limits, see WebRequest.cpp. The sketch refuses to build without
+// this define.
+#define ESPASYNCWEBSRV_SPLITFLAP_LIMITS 1
+#ifndef ASYNCWEBSERVER_MAX_PARAMS
+#define ASYNCWEBSERVER_MAX_PARAMS 32        // query + form + multipart parameters per request
+#endif
+#ifndef ASYNCWEBSERVER_MAX_HEADERS
+#define ASYNCWEBSERVER_MAX_HEADERS 40       // header lines per request (browsers send ~20)
+#endif
+#ifndef ASYNCWEBSERVER_MAX_HEAD_LINE
+#define ASYNCWEBSERVER_MAX_HEAD_LINE 2048   // bytes of the request line or one header line
+#endif
+#ifndef ASYNCWEBSERVER_MIN_FREE_HEAP
+#define ASYNCWEBSERVER_MIN_FREE_HEAP 5000   // the parser stops allocating below this free heap
+#endif
+
 //if this value is returned when asked for data, packet will not be sent and you will be asked for data again
